{
  "name": "infomentor-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PoC: läs Infomentor (Mentor) med e-post/lösenord och kartlägg endpoints + barn",
  "scripts": {
    "login": "node src/login.js",
    "probe": "node src/probe.js",
    "probe:uol": "node src/probe-uol.js",
    "flow": "node src/flowcheck.js",
    "test": "node --no-warnings --test test/*.test.js",
    "history": "node src/history.js",
    "publish:ha": "node src/publish-ha.js",
    "purge:ha": "node src/publish-ha.js --purge",
    "collect": "node src/collect.js",
    "report": "node src/report.js",
    "mail": "python3 src/send_mail.py",
    "mail:test": "MAIL_DRY_RUN=1 python3 src/send_mail.py"
  }
}
