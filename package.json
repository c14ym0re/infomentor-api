{
  "name": "infomentor-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Unofficial InfoMentor toolkit: log in with an email/password Mentor account, read calendar/timetable/assignments/attendance, fetch the school lunch menu, publish Home Assistant sensors, keep a searchable history, and send an evening family report by email with event-driven alerts.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --no-warnings --test test/*.test.js",
    "flow": "node src/flowcheck.js",
    "login": "node src/login.js",
    "probe": "node src/probe.js",
    "probe:apps": "node src/probe-apps.js",
    "collect": "node src/collect.js",
    "watch": "node src/watch.js",
    "watch:once": "node src/watch.js --once",
    "digest": "node src/watch.js --digest",
    "history": "node src/history.js",
    "report": "node src/report.js",
    "publish:ha": "node src/publish-ha.js",
    "mail": "python3 src/send_mail.py",
    "mail:test": "MAIL_DRY_RUN=1 python3 src/send_mail.py",
    "week": "node src/week-check.js"
  }
}
